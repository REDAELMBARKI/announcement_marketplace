# Docker Compose Environment Variables

# Docker Hub registry (optional)
DOCKER_REGISTRY=your-dockerhub-username

# Dynu API Key for DNS-01 certificate issuance
# Create one at: https://www.dynu.com/en-US/ControlPanel/APICredentials
DYNU_API_KEY=your-dynu-api-key-here

# MySQL root password (optional)
MYSQL_ROOT_PASSWORD=your-root-password-here

# Backend
WWWGROUP=1000
APP_ENV=local
APP_DEBUG=true
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=announcement_db
DB_USERNAME=app_user
DB_PASSWORD=app_password_123
